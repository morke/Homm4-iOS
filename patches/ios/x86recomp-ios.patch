+    vec3 d = max(max(abs(s1 - c), abs(s2 - c)), max(abs(s3 - c), abs(s4 - c)));
+    if (any(greaterThan(d, kStep))) break;
+    sum += s1 + s2 + s3 + s4;
+    n += 4.0;
+  }
+  return sum / n;
+}
