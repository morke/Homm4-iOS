diff --git a/tests/guest_alloc_test.cpp b/tests/guest_alloc_test.cpp
new file mode 100644
index 0000000..ccc93ba
--- /dev/null
+++ b/tests/guest_alloc_test.cpp
@@ -0,0 +1,107 @@
+// guest_alloc_test: VirtualAlloc-style reservations. Checks that:
+//   - a top-down reservation skips a gap that can hold the size but not
+//     once its base is aligned down to 64 KiB, and lands in the next gap
+//     down instead of failing;
+//   - top-down and bottom-up reservations are 64 KiB aligned, inside the
+//     bounds, and never overlap an existing reservation;
+//   - the space under the lowest reservation is used when nothing above
+//     fits.
+
+#include <cstdint>
+#include <cstdio>
+#include <random>
+#include <vector>
+
+#include "runtime/guest_alloc.h"
+#include "runtime/guest_memory.h"
+
+using namespace recomp;
+
+namespace {
+
+int g_failures = 0;
+
+#define CHECK(cond)                                                       \
+  do {                                                                    \
+    if (!(cond)) {                                                        \
+      std::fprintf(stderr, "%s:%d: CHECK failed: %s\n", __FILE__, __LINE__, \
+                   #cond);                                                \
+      g_failures++;                                                       \
+    }                                                                     \
+  } while (0)
+
+constexpr uint64_t kLo = 0x10000, kHi = 0x80000000u;
+constexpr uint64_t kGran = GuestAllocator::kGranularity;
+
+GuestMemory g_mem;
+
+bool Overlaps(GuestAllocator& vm, uint64_t base, uint64_t size) {
+  for (uint64_t p = base; p < base + size; p += 0x1000) {
+    GuestAllocator::Region r;
+    if (vm.Find(p, &r) && r.base != base) return true;
+  }
+  return false;
+}
+
+// The top gap holds 0xEC000 bytes; 0xEA000 fits there only below its
+// bottom once aligned down.
+void UnalignedTopGap() {
+  GuestAllocator vm;
+  vm.Init(&g_mem, kLo, kHi);
+  vm.MarkReserved(0x7F100000, kHi - 0x7F100000);
+  vm.MarkReserved(0x7F000000, 0x14000);
+  uint64_t a = vm.Reserve(0, 0xEA000, true);
+  CHECK(a != 0);
+  CHECK(a % kGran == 0);
+  CHECK(a + 0xEA000 <= 0x7F000000);
+  CHECK(a == ((0x7F000000 - 0xEA000) & ~(kGran - 1)));
+}
+
+// Only the space under the lowest reservation is free.
+void BelowLowest() {
+  GuestAllocator vm;
+  vm.Init(&g_mem, kLo, kHi);
+  vm.MarkReserved(0x00400000, kHi - 0x00400000);
+  uint64_t a = vm.Reserve(0, 0x100000, true);
+  CHECK(a != 0 && a >= kLo && a + 0x100000 <= 0x00400000 && a % kGran == 0);
+  CHECK(vm.Reserve(0, 0x400000, true) == 0);
+}
+
+// Random sizes, both directions, with releases in between.
+void Random() {
+  GuestAllocator vm;
+  vm.Init(&g_mem, kLo, kHi);
+  std::mt19937 rng(7);
+  std::vector<uint64_t> live;
+  for (int i = 0; i < 4000; i++) {
+    if (!live.empty() && rng() % 3 == 0) {
+      size_t k = rng() % live.size();
+      vm.Release(live[k], false);
+      live.erase(live.begin() + k);
+      continue;
+    }
+    uint64_t size = (1 + rng() % 400) * 0x1000;
+    bool down = rng() % 2;
+    uint64_t a = vm.Reserve(0, size, down);
+    CHECK(a != 0);
+    if (!a) continue;
+    CHECK(a % kGran == 0 && a >= kLo && a + size <= kHi);
+    CHECK(!Overlaps(vm, a, size));
+    live.push_back(a);
+  }
+}
+
+}  // namespace
+
+int main() {
+  if (!g_mem.Reserve()) return 1;
+  UnalignedTopGap();
+  BelowLowest();
+  Random();
+  if (g_failures) {
+    std::fprintf(stderr, "%d failure(s)\n", g_failures);
+    return 1;
+  }
+  std::printf("guest_alloc: ok\n");
+  return 0;
+}
