+// Hitches: while the main thread spends over 40 ms away from the window
+// system (one long pass of the game), its lifted functions at that moment
+// go to the log (seconds since start, innermost first), a few a second:
+// short stalls a player sees as stutter, too short for a hang dump.
+void HitchMain() {
+  const int64_t start = NowMs();
+  int64_t last_beat = 0, window = 0;
+  int in_window = 0;
+  for (;;) {
+    std::this_thread::sleep_for(std::chrono::milliseconds(5));
+    const int64_t beat = g_beat.load(), now = NowMs();
+    if (!beat || beat == last_beat || now - beat < 40) continue;
+    last_beat = beat;  // one sample per stall
+    if (now - window >= 1000) window = now, in_window = 0;
+    if (++in_window > 5) continue;
+    pthread_t th;
+    {
+      std::lock_guard<std::mutex> l(g_mu);
+      if (g_threads.empty()) continue;
+      th = g_threads.front().th;
+    }
+    g_sample_n.store(-2);
+    if (pthread_kill(th, SIGUSR2) != 0) continue;
+    for (int i = 0; i < 40 && g_sample_n.load() < 0; i++)
+      std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    const int n = g_sample_n.exchange(-1);
+    if (n <= 0) continue;
+    std::string line;
+    int kept = 0;
+    for (int i = 0; i < n && kept < 10; i++) {
+      Dl_info info;
+      if (!dladdr(g_sample[i], &info) || !info.dli_sname) continue;
+      const char* f = std::strstr(info.dli_sname, "f_00");
+      const char* h = std::strstr(info.dli_sname, "hle_");
+      if (f) line += " " + std::string(f, 10), kept++;
+      else if (h && !kept) line += " " + std::string(h, strcspn(h, "E(")), kept++;
+    }
+    std::fprintf(stderr, "warning: hitch at %.1f s, %lld ms so far:%s\n",
+                 double(now - start) / 1000.0, (long long)(now - beat), line.c_str());
+  }
+}
