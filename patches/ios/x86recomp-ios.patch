+// ---- deband: 16-bit colour's steps in flat areas smoothed (src = the
+// frame, at its size). Rings of four samples at growing distances, at an
+// angle that varies from pixel to pixel, are averaged in as long as every
+// sample lies within about one RGB565 step of the pixel; the first ring
+// with a larger difference (an edge, detail) stops it.
+float Hash(vec2 p) { return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453); }
+
+vec3 Deband(vec2 uv) {
+  ivec2 ip = ivec2(uv * size.xy);
+  vec3 c = Texel(ip);
+  const vec3 kStep = vec3(1.25 / 31.0, 1.25 / 63.0, 1.25 / 31.0);
+  vec3 sum = c;
+  float n = 1.0;
+  float a = Hash(vec2(ip)) * 6.2831853;
+  for (int i = 1; i <= 4; i++) {
+    float r = float(i * i) + 1.0;  // 2, 5, 10, 17 pixels
+    vec2 o = r * vec2(cos(a + float(i) * 2.4), sin(a + float(i) * 2.4));
