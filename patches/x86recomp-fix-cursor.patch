+  SDL_GPUShader* cursor_fs_ = nullptr;
+  SDL_GPUSampler* cursor_sampler_ = nullptr;
+  SDL_GPUGraphicsPipeline* cursor_pipe_ = nullptr;
+  SDL_GPUTextureFormat cursor_fmt_ = SDL_GPU_TEXTUREFORMAT_INVALID;
   SDL_GPUTexture* dummy_ = nullptr;
   int bb_w_ = 0, bb_h_ = 0;
   // Mailbox emulated on vsync (ResetSwapChain, Show).
@@ -3401,6 +3515,21 @@ void SetPresentOverlays(std::vector<PresentOverlay> overlays) {
