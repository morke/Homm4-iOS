 }
 
+void SetPresentCursor(const uint32_t* argb, int w, int h) {
+  std::lock_guard<std::mutex> l(g_cursor_mu);
+  g_cursor_image.assign(argb, argb + size_t(std::max(w, 0)) * size_t(std::max(h, 0)));
+  g_cursor_iw = w;
+  g_cursor_ih = h;
+  g_cursor_gen++;
+}
+
+void SetPresentCursorPos(int x, int y, bool shown) {
+  std::lock_guard<std::mutex> l(g_cursor_mu);
+  g_cursor_x = x;
+  g_cursor_y = y;
+  g_cursor_shown = shown;
+}
+
 std::unique_ptr<Device> CreateGpuDevice(SDL_Window* window) {
   auto d = std::make_unique<GpuDevice>(window);
   if (!d->Init()) return nullptr;
