+// The pointer: its picture as it is, the transparent pixels dropped.
+constexpr const char* kCursorFrag = R"(#version 450
+layout(location = 0) in vec2 uv;
+layout(location = 0) out vec4 frag;
+layout(set = 2, binding = 0) uniform sampler2D img;
