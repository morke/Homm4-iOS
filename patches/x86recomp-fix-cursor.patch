+  // The pointer's picture, (re)made from SetPresentCursor's when it changed:
+  // before the Flush that precedes a present, like the overlays.
+  void SyncCursor() {
+    std::lock_guard<std::mutex> cl(g_cursor_mu);
+    if (cursor_gen_ == g_cursor_gen) return;
+    cursor_gen_ = g_cursor_gen;
+    if (cursor_tex_) DestroyTexture(cursor_tex_);
+    cursor_tex_ = 0;
+    cursor_iw_ = g_cursor_iw;
+    cursor_ih_ = g_cursor_ih;
+    if (cursor_iw_ <= 0 || cursor_ih_ <= 0 ||
+        g_cursor_image.size() < size_t(cursor_iw_) * cursor_ih_)
+      return;
+    cursor_tex_ = CreateTexture(cursor_iw_, cursor_ih_, 1, Format::A8R8G8B8, false);
+    if (cursor_tex_)
+      UpdateTexture(cursor_tex_, 0, Rect{0, 0, cursor_iw_, cursor_ih_}, g_cursor_image.data(),
+                    uint32_t(cursor_iw_) * 4);
+  }
+
+  // The pointer over the frame shown at r (w x h), scaled as the frame is,
+  // its pixels kept sharp.
+  void DrawCursor(SDL_GPUCommandBuffer* cmd, SDL_GPUTexture* sc, const Rect& r, int w, int h) {
+    int x, y;
+    {
+      std::lock_guard<std::mutex> cl(g_cursor_mu);
+      if (!g_cursor_shown || !cursor_tex_) return;
+      x = g_cursor_x;
+      y = g_cursor_y;
+    }
+    SDL_GPUColorTargetInfo t{};
+    t.texture = sc;
+    t.load_op = SDL_GPU_LOADOP_LOAD;
+    t.store_op = SDL_GPU_STOREOP_STORE;
+    SDL_GPURenderPass* rp = SDL_BeginGPURenderPass(cmd, &t, 1, nullptr);
+    SDL_BindGPUGraphicsPipeline(rp, CursorPipeline());
+    const float kx = float(w) / float(bb_w_), ky = float(h) / float(bb_h_);
+    SDL_GPUViewport vp{float(r.left) + float(x) * kx, float(r.top) + float(y) * ky,
+                       float(cursor_iw_) * kx, float(cursor_ih_) * ky, 0.0f, 1.0f};
+    SDL_SetGPUViewport(rp, &vp);
+    SDL_GPUTextureSamplerBinding b{textures_[cursor_tex_].tex, cursor_sampler_};
+    SDL_BindGPUFragmentSamplers(rp, 0, &b, 1);
+    const float unused[4] = {};
+    SDL_PushGPUFragmentUniformData(cmd, 0, unused, sizeof unused);
+    SDL_DrawGPUPrimitives(rp, 3, 1, 0, 0);
+    SDL_EndGPURenderPass(rp);
+  }
+
+  // The pointer's pipeline for the swap chain's format (built on first use).
+  SDL_GPUGraphicsPipeline* CursorPipeline() {
+    const SDL_GPUTextureFormat fmt = SDL_GetGPUSwapchainTextureFormat(dev_, window_);
+    PresentPipeline();  // the vertex shader
+    if (cursor_pipe_ && cursor_fmt_ == fmt) return cursor_pipe_;
+    if (!cursor_fs_) {
+      cursor_fs_ = CompilePresentShader(kCursorFrag, false, 1);
+      SDL_GPUSamplerCreateInfo si{};
+      si.min_filter = si.mag_filter = SDL_GPU_FILTER_NEAREST;
+      si.mipmap_mode = SDL_GPU_SAMPLERMIPMAPMODE_NEAREST;
+      si.address_mode_u = si.address_mode_v = si.address_mode_w =
+          SDL_GPU_SAMPLERADDRESSMODE_CLAMP_TO_EDGE;
+      cursor_sampler_ = SDL_CreateGPUSampler(dev_, &si);
+    }
+    if (cursor_pipe_) SDL_ReleaseGPUGraphicsPipeline(dev_, cursor_pipe_);
+    SDL_GPUColorTargetDescription ct{};
+    ct.format = fmt;
+    SDL_GPUGraphicsPipelineCreateInfo pi{};
+    pi.vertex_shader = present_vs_;
+    pi.fragment_shader = cursor_fs_;
+    pi.primitive_type = SDL_GPU_PRIMITIVETYPE_TRIANGLELIST;
+    pi.rasterizer_state.cull_mode = SDL_GPU_CULLMODE_NONE;
+    pi.target_info.color_target_descriptions = &ct;
+    pi.target_info.num_color_targets = 1;
+    cursor_pipe_ = SDL_CreateGPUGraphicsPipeline(dev_, &pi);
+    if (!cursor_pipe_) FatalF("gfx: cursor pipeline: %s", SDL_GetError());
+    cursor_fmt_ = fmt;
+    return cursor_pipe_;
+  }
