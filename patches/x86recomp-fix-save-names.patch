 // Absolute, normalised guest path: "C:\x\y".
+// Guest file names (the ANSI code page, Windows-1252) <-> host ones (UTF-8):
+// APFS takes only valid UTF-8 names, and a name with bytes 0x80-0xFF (text
+// of a translation, e.g. Cyrillic in Windows-1251 read here as 1252) could
+// not be made. ASCII names stay as they are; others are kept as the
+// characters of their bytes, so a name the game writes reads back the same.
+bool Ascii(const std::string& s) {
+  for (unsigned char ch : s)
+    if (ch >= 0x80) return false;
+  return true;
+}
+std::string HostName(const std::string& guest) {
+  if (Ascii(guest)) return guest;
+  const std::u16string w = win32::Widen(guest);
+  bool bad;
+  return win32::Utf16ToUtf8(w.data(), w.size(), &bad);
+}
+std::string GuestName(const std::string& host) {
+  if (Ascii(host)) return host;
+  bool bad;
+  return win32::Narrow(
+      win32::Utf8ToUtf16(reinterpret_cast<const uint8_t*>(host.data()), host.size(), &bad));
+}
